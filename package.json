{
  "name": "pi-visual-desktop",
  "version": "0.2.0",
  "description": "Local visual-first macOS desktop primitives for Pi",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "native",
    "test/manual",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "setup": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "build:fixture": "node scripts/build-fixture.mjs",
    "test:native": "build/desktop-helper --self-test",
    "health": "build/desktop-helper --health"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "typebox": "^1.1.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
